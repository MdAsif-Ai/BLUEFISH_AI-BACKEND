# ── Celery ────────────────────────────────────────────────────
# Uses separate Redis DB indices (1, 2) to avoid collision with app cache (DB 0)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Supabase Storage ──────────────────────────────────────────
ML_MODELS_BUCKET=ml-models

# ── Fleet Monitoring ──────────────────────────────────────────
FLEET_POLL_INTERVAL_SECONDS=60
FLEET_MAX_VESSELS_PER_CYCLE=20000

# ── Collision Detection ───────────────────────────────────────
COLLISION_CPA_THRESHOLD_KM=0.5
COLLISION_TCPA_THRESHOLD_MIN=15.0

# ── Anomaly Detection ─────────────────────────────────────────
ANOMALY_SCORE_THRESHOLD=-0.1

# ── Retraining ────────────────────────────────────────────────
RETRAINING_MIN_NEW_FEEDBACK_ROWS=200

# ── Digital Twin ─────────────────────────────────────────────
DIGITAL_TWIN_MAX_DAYS=90

# ── CORS ──────────────────────────────────────────────────────
# Restrict this in production to your exact frontend domain
# CORS_ORIGINS=["https://your-nextjs-app.vercel.app", "https://admin.bluefish.gov.in"]
CORS_ORIGINS=["*"]

# ── Render.com Specific ───────────────────────────────────────
# PORT is set automatically by Render. Do not override unless needed.
# PORT=8000
