# ============================================================
# BlueFish AI Backend - Environment Variables
# Copy this file to .env and fill in your real values.
# On Render.com, set these in the Service → Environment tab.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Redis ─────────────────────────────────────────────────────
# On Render.com, add a Redis service and it provides this URL automatically.
REDIS_URL=redis://localhost:6379

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Supabase Storage ──────────────────────────────────────────
ML_MODELS_BUCKET=ml-models

# ── Fleet Monitoring ──────────────────────────────────────────
FLEET_POLL_INTERVAL_SECONDS=60
FLEET_MAX_VESSELS_PER_CYCLE=20000

# ── Collision Detection ───────────────────────────────────────
COLLISION_CPA_THRESHOLD_KM=0.5
COLLISION_TCPA_THRESHOLD_MIN=15.0

# ── Anomaly Detection ─────────────────────────────────────────
ANOMALY_SCORE_THRESHOLD=-0.1

# ── Retraining ────────────────────────────────────────────────
RETRAINING_MIN_NEW_FEEDBACK_ROWS=200

# ── Digital Twin ─────────────────────────────────────────────
DIGITAL_TWIN_MAX_DAYS=90

# ── CORS ──────────────────────────────────────────────────────
# Restrict this in production to your exact frontend domain
# CORS_ORIGINS=["https://your-nextjs-app.vercel.app", "https://admin.bluefish.gov.in"]
CORS_ORIGINS=["*"]

# ── Render.com Specific ───────────────────────────────────────
# PORT is set automatically by Render. Do not override unless needed.
# PORT=8000
